{
  "name": "medimart-server",
  "version": "1.0.0",
  "description": "MediMart Express server matching the QuickShow coding style",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "server": "nodemon server.js",
    "start": "node server.js",
    "build": "cd client && npm install && npm run build",
    "check": "node --check server.js",
    "check:client": "cd client && npm run lint",
    "check:all": "npm run check && npm run check:client"
  },
  "keywords": [
    "pharmacy",
    "ecommerce",
    "medicine",
    "mern",
    "express",
    "mongodb",
    "mongoose",
    "clerk"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^1.5.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "inngest": "^3.38.0",
    "mongoose": "^8.15.1",
    "nodemailer": "^7.0.3",
    "svix": "^1.66.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
